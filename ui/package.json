{
  "name": "jianlai-studio",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [],
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "bun run check:toolchain && react-router build && node scripts/export-client.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "VITE_APP_BASE=/jianlai/ bun test tests/*.test.ts",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript ../docs/openapi.yaml -o src/api/generated.ts",
    "lint": "eslint src app e2e scripts",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "api:check": "node scripts/check-api-types.mjs"
  },
  "dependencies": {
    "@react-router/node": "^7.18.5",
    "@tanstack/react-query": "^5.90.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "lucide-react": "^1.62.0",
    "motion": "^12.23.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.13.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^7.9.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.0",
    "@react-router/dev": "^7.9.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
